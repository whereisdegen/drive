# Privy 3.x declares @solana/kit and @solana-program/* as OPTIONAL peers, but its `/solana`
# subpath imports them statically, so a bundler needs them present. Installing them then trips
# npm's peer resolver: a transitive @solana/kit@5 (via @coinbase/cdp-sdk, pulled in by wagmi,
# pulled in by Privy's EVM connectors we do not use) conflicts with the ^8.3.0 that
# @solana-program/memo wants - even though the version npm picks, 8.4.0, satisfies it.
#
# The versions are pinned in package.json and the lockfile, and the built bundle is tested, so
# what matters here is that the install is reproducible rather than that npm approves of it.
legacy-peer-deps=true
